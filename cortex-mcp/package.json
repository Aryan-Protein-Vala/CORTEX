  },
  "files": [
    "index.js",
    "scripts/smoke.mjs",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aryan-Protein-Vala/CORTEX.git",
    "directory": "cortex-mcp"
  },
