# CORTEX environment variables — every one of these is read by code in this
# repo (grep-verified). Nothing here is "for later".
#
# There is no single root .env: each surface reads its own process environment.
# The core is a Rust binary (shell env), the MCP server is a Node process
# (env block in your editor config), the frontend is Next.js (its own .env.local).
# Copy only the block you need.
#
#   # core:            export $(grep -v '^#' this-file | xargs)   # or pass inline
#   # MCP:             ./setup-cursor-mcp.sh writes the editor's env block for you
#   # frontend:        cp cortex-frontend/.env.local.example cortex-frontend/.env.local

# ─── cortex-core: required for nothing, all of it is opt-in ───────────────────
# Port/host. With no key set the server refuses to bind beyond loopback on
# purpose, so a stray 0.0.0.0 needs a deliberate decision, not a default.
# CORTEX_HOST=127.0.0.1
# CORTEX_PORT=3030

# The one variable that changes the security posture: setting a key unlocks
# non-loopback binds and cross-origin access, and every client must send it.
# Generate one: openssl rand -hex 24
# CORTEX_API_KEY=

# Where memory lives. Default: ~/.cortex/cortex-graph.json (one JSON file, no
# Docker). Pointed at a backend that is down, the core falls back to the file
# and says so in the log — unless CORTEX_REQUIRE_SURREAL is set, in which case
# it refuses to start rather than write somewhere unexpected.
# CORTEX_DATA_DIR=~/.cortex
# CORTEX_SURREAL_URL=ws://127.0.0.1:8000
# CORTEX_SURREAL_USER=root
# CORTEX_SURREAL_PASS=
# CORTEX_SURREAL_NS=cortex
# CORTEX_SURREAL_DB=memory
# CORTEX_REQUIRE_SURREAL=1
# CORTEX_QDRANT_URL=http://127.0.0.1:6333
# Optional: OpenAI embeddings for the Qdrant index (heuristic ranking otherwise)
# OPENAI_API_KEY=

# Extraction. Unset = offline heuristic extractor (no network, lower recall,
# still honest about which mode it is in in /health).
# OPENROUTER_API_KEY=
# CORTEX_EXTRACTOR_MODEL=google/gemini-flash-1.5-8b

# Identity + recall shape.
# CORTEX_DEFAULT_OWNER=cortex://default          # legacy alias: CORTEX_USER_ID
# CORTEX_TOKEN_BUDGET=600                        # briefing size injected by default
# CORTEX_MAX_TOKEN_BUDGET=4000
# CORTEX_DECAY_POLICY=soft                       # soft | hard — hard forgets

# Concurrency and limits.
# CORTEX_MAX_CONCURRENT_JOBS=8
# CORTEX_RATE_LIMIT_PER_MIN=240
# CORTEX_SWEEP_INTERVAL_SECS=3600
# CORTEX_SESSION_IDLE_SECS=90
# CORTEX_SESSION_MAX_MESSAGES=40

# Browsers that may call the core directly (the dashboard proxy never needs this).
# CORTEX_ALLOWED_ORIGINS=http://localhost:3000

# Shared mesh: deliberately off. Both must be set, and publishing is still
# append-only — there is no CRDT sync engine (see cortex-core/src/api/sync.rs).
# CORTEX_ALLOW_MESH_PUBLISH=1
# CORTEX_MESH_PATH=~/.cortex/mesh.json

# ─── cortex-mcp (put these in the editor's mcp.json env block) ────────────────
# CORTEX_API_URL=http://127.0.0.1:3030
# CORTEX_OWNER=cortex://default
# CORTEX_API_KEY=                                # must match the core's
# CORTEX_TOKEN_BUDGET=500
# CORTEX_TIMEOUT_MS=20000
# CORTEX_INCLUDE_MESH=0                          # 1 to search published memory
# CORTEX_READ_DIRS=                              # colon-separated roots cortex_remember_files may read
# CORTEX_MAX_FILE_BYTES=200000

# ─── cortex-frontend (cortex-frontend/.env.local) ─────────────────────────────
# Server-side only: the browser talks to /api/core, never to the core directly,
# so the key never reaches the page.
# CORTEX_API_URL=http://127.0.0.1:3030
# CORTEX_API_KEY=
# CORTEX_PROXY_TIMEOUT_MS=15000
# CORTEX_HYDRATE_MAX=400
# CORTEX_CONTACT_FILE=~/.cortex/contact.jsonl
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_CORTEX_WS_URL=                      # set only if you want the live brain feed

# ─── cortex-desktop (read at runtime; the popup can override both) ─────────────
# CORTEX_CORE_URL=http://127.0.0.1:3030
# CORTEX_OWNER=cortex://default
# CORTEX_API_KEY=

# Not read by anything in this repo (do not expect them to work): Clerk
# auth keys, Stripe/`STRIPE_SECRET_KEY` billing, `S3_*`/Postgres connection
# strings, OpenTelemetry/Datadog keys. They were listed in earlier versions of
# this file while the features were still a plan. Billing and hosted accounts
# are not implemented; when they are, this file changes first.
